# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=

# Discord application/client ID
DISCORD_CLIENT_ID=

# Discord server (guild) ID — REQUIRED as of Phase 17 (Wren Rebirth).
# This is Wren's primary safety boundary: she only operates in this one
# guild, and slash commands register instantly to it instead of globally.
# The Whisper About It / Unfiltered Talk Radio guild ID is 1549772221226950686.
# Do NOT set this to the old WhisperSMP/gaming guild ID.
DISCORD_GUILD_ID=

# Optional. Restricts admin/ops surfaces (project awareness, handoffs,
# control panels) to one specific channel, IN ADDITION to the admin
# permission check those surfaces already require -- not a replacement for
# it. Leave unset to rely on the admin-permission check alone. Public
# conversational features (mentions, /wren ask) are guild-scoped, not
# channel-scoped, and never read this variable.
DISCORD_CHANNEL_ID=

# Environment: development | production
NODE_ENV=development

# Log level: error | warn | info | debug
LOG_LEVEL=info
